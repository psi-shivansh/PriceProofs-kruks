# PriceProof — Environment Configuration Example
# Copy this file to .env to configure local overrides.
# Never commit real credentials or secret keys to version control.

# Server Port (AI Studio runtime expects 3000)
PORT=3000

# ---------------------------------------------------------------------------
# Authorized E-Commerce Partner Provider Credentials (Optional)
# If omitted, PriceProof runs automatically with the live Open E-Commerce API
# and the rich multi-seller Demo dataset.
# ---------------------------------------------------------------------------

# Amazon Product Advertising API (PA-API v5)
# Obtain from: https://affiliate-program.amazon.com / Tools -> Product Advertising API
# Requires an active Amazon Associates account with at least 3 qualifying sales.
AMAZON_PAAPI_ACCESS_KEY=""
AMAZON_PAAPI_SECRET_KEY=""
AMAZON_ASSOCIATE_TAG=""
AMAZON_PAAPI_REGION="us-east-1" # e.g. 'us-east-1' for US (webservices.amazon.com), 'eu-west-1' for IN (webservices.amazon.in)

# Flipkart Affiliate API
# Obtain from: https://affiliate.flipkart.com/api-docs
FLIPKART_AFFILIATE_ID=""
FLIPKART_AFFILIATE_TOKEN=""

# Standard AI Studio Environment Variables (Auto-injected in production)
GEMINI_API_KEY=""
APP_URL=""
